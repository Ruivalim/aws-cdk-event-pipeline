dist/
*.tsbuildinfo

# cdk build output
cdk.out/

# cdk.context.json is a cache of live AWS lookups. It is not committed: the
# only lookup in this app was availability zones, and that is now avoided by
# naming zones explicitly. When it does get created it carries the caller's
# account id.
cdk.context.json

